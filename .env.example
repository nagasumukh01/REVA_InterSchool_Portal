# Copy this file to .env and fill in real values before deploying.

# Bootstrap admin account (only used the very first time the app runs,
# i.e. before data/admins.json exists)
REVA_ADMIN_EMAIL=sportsdirector@reva.edu.in
REVA_ADMIN_PASSWORD=ChangeThisPassword123!

# Storage backend: "json" (default, file-based) or "flask" (once you wire up
# a real backend — see utils/storage.py)
REVA_STORAGE_BACKEND=json
REVA_API_BASE_URL=http://localhost:5000/api
